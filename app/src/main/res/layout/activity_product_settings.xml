<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include"
        layout="@layout/layout_tiu_header" />


    <RadioGroup
        android:id="@+id/grp_radio_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:padding="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <RadioButton
            android:id="@+id/rdo_filter_type_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Admin and Cashier" />

        <RadioButton
            android:id="@+id/rdo_filter_type_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cashier Only" />

        <RadioButton
            android:id="@+id/rdo_filter_type_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bill Payments"
            android:visibility="gone" />
    </RadioGroup>


    <RadioGroup
        android:id="@+id/grp_radio_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:orientation="horizontal"
        android:padding="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <RadioButton
            android:id="@+id/rdo_filter_product_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="By Products" />

        <RadioButton
            android:id="@+id/rdo_filter_product_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="By Denominations" />


    </RadioGroup>

    <EditText
        android:id="@+id/txt_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:ems="10"
        android:hint="Serial Number / UID"
android:visibility="invisible"
        android:inputType="text"

        app:layout_constraintTop_toBottomOf="@+id/grp_radio_product" />






 <!--  <Spinner
        android:id="@+id/spinnerproduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_top_search"
        />-->

    <TextView
        android:id="@+id/tv_mess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
android:layout_marginTop="200dp"
        android:layout_marginStart="25dp"
        android:text="Uncheck Product to Disable"
        android:textColor="#3c3c3c"
        android:textSize="15sp"
        android:textStyle="bold"
    />


    <za.co.topitupkeyboard.utils.MultiSelectionSpinner
        android:id="@+id/spinnerproduct"
        android:layout_width="275dp"

        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="225dp"
        android:background="@drawable/spinner_background"
        app:layout_constraintBottom_toBottomOf="@+id/txt_input" />






        <Button
            android:id="@+id/btn_bottom_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_weight="1"
            android:layout_alignParentBottom="true"
            android:onClick="onclick_btn_action"
            android:visibility="gone"
            android:text="Close" />

        <Button
            android:id="@+id/btn_bottom_reprint_last"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_weight="1"
            android:visibility="gone"
            android:onClick="onclick_btn_action"
            android:text="Reprint Last" />

    <android.support.design.widget.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:labelVisibilityMode="labeled"
        android:background="@color/colorPrimary"
        app:itemIconTint="@drawable/bottom_navigation_colors"
        app:itemTextColor="@drawable/bottom_navigation_colors"
        app:menu="@menu/bottom_navigation_admin_menu" />


</FrameLayout>