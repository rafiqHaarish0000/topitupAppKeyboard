<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/maincontent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@color/white">
    <include layout="@layout/layout_tiu_header" />

    <TextView
        android:id="@+id/txt_app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text=""
        android:gravity="left"
        android:textColor="#cecece"
        android:layout_marginTop="50dp"
        android:paddingLeft="10dp"
        android:textSize="12sp" />


    <ImageView
        android:paddingTop="25dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/activity_login_admin"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:background="@drawable/logo_splash"
        android:layout_marginTop="50dp"

        />


    <RelativeLayout
        android:id="@+id/login_text_button_layout"
        android:layout_below="@id/activity_login_admin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="@dimen/ten_dp"
        >

        <EditText
            android:id="@+id/activity_login_access_code_value"
            android:layout_width="match_parent"
            android:layout_height="50dp"

            android:layout_centerHorizontal="true"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:background="@drawable/login_pad_edit_text"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:textColor="#3c3c3c"
            android:textSize="30sp" />
        <TextView
            android:id="@+id/textLastSale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingLeft="5dp"

            android:paddingTop="10dp"
            android:paddingRight="5dp"
            android:textColor="@color/main_color_orange"
            android:text=""
            android:textSize="14sp"  />
        <ProgressBar
            android:id="@+id/login_button_progress"
            android:layout_centerVertical="true"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:paddingLeft="@dimen/two_dp"
            android:paddingRight="@dimen/two_dp"
            android:layout_alignBottom="@id/activity_login_access_code_value"
            android:layout_alignTop="@id/activity_login_access_code_value"
            android:layout_alignLeft="@id/activity_login_access_code_value"
            android:layout_alignRight="@id/activity_login_access_code_value" />
    </RelativeLayout>

    <TableLayout
        android:id="@+id/activity_login_pad_table_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/login_text_button_layout"

        android:gravity="center"
        android:paddingTop="15dp"
        android:paddingBottom="0dp">

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp">

            <TextView
                android:id="@+id/one_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="1"
                android:textColor="#811d1d"
                android:textSize="@dimen/thirty_two_sp" />

            <TextView
                android:id="@+id/two_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="2"
                android:textColor="#811d1d"
                android:textSize="@dimen/thirty_two_sp" />

            <TextView
                android:id="@+id/three_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="3"
                android:textColor="#811d1d"
                android:textSize="@dimen/thirty_two_sp" />

        </TableRow>

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp">

            <TextView
                android:id="@+id/four_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="4"
                android:textColor="#811d1d"
                android:textSize="@dimen/thirty_two_sp" />

            <TextView
                android:id="@+id/five_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="5"
                android:textColor="#811d1d"
                android:textSize="@dimen/thirty_two_sp" />

            <TextView
                android:id="@+id/six_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="6"
                android:textColor="#811d1d"
                android:textSize="@dimen/thirty_two_sp" />

        </TableRow>

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp">

            <TextView
                android:id="@+id/seven_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="7"
                android:textColor="#811d1d"
                android:textSize="@dimen/thirty_two_sp" />

            <TextView
                android:id="@+id/eight_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="8"
                android:textColor="#811d1d"
                android:textSize="@dimen/thirty_two_sp" />

            <TextView
                android:id="@+id/nine_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="9"
                android:textColor="#811d1d"
                android:textSize="@dimen/thirty_two_sp" />

        </TableRow>

    </TableLayout>

    <RelativeLayout
        android:layout_below="@id/activity_login_pad_table_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:orientation="vertical">

        <WebView
            android:id="@+id/wb_notice"
            android:layout_width="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="0dp"

            android:paddingTop="150dp"
            android:layout_height="200dp"
            android:layout_marginTop="2dp" />

        <ImageView
            android:id="@+id/newImageView"
            android:layout_width="100dp"
            android:layout_height="60dp"
            android:visibility="gone"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="0dp"
            android:paddingTop="5dp"
            android:src="@drawable/prov_new" />


      <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_below="@+id/newImageView"
            android:scrollbars = "vertical"
            android:layout_gravity="center_vertical|end"
            android:layout_marginTop="-5dp"
            android:layout_weight="1"
            android:gravity="left"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:paddingBottom="2dp"
            android:maxLines="5"

            android:ellipsize="end"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"

            android:layout_marginBottom="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/activity_login_is_demo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="0dp"

                android:text="DEMO"
                android:textColor="#ff0000"
                android:textSize="18dp" />


        <!--    <TextView
                android:id="@+id/btn_show_more_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background=""
                android:clickable="true"
                android:gravity="center"
                android:onClick="click_show_more"
                android:paddingRight="75dp"
                android:paddingBottom="5dp"
                android:text="0860 111 723"
                android:textColor="#313131"
                android:textSize="15dp" />-->



        </LinearLayout>

    </RelativeLayout>
    <ImageView

        android:id="@+id/btn_show_more_contact"

        android:src="@drawable/bottom"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:scaleType="fitXY"
        android:contentDescription="0860 111 723"
        android:gravity="bottom|center_horizontal" />

</RelativeLayout>