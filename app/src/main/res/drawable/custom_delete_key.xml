<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FF0000"/> <!-- Red when pressed -->
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FFA500"/> <!-- Orange when not pressed -->
            <corners android:radius="5dp"/>
        </shape>
    </item>
</selector>